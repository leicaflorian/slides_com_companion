{
  "name": "slides_com_companion",
  "version": "1.4.1",
  "description": "Chrome/Edge extension that aims to add a few missing features (free) to Slides.com presentations.",
  "private": true,
  "type": "module",
  "author": "Leica Florian <florian.leica@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "wxt build && playwright test",
    "snapshot": "tsx scripts/snapshot.ts",
    "icons": "tsx scripts/icons.ts"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "events": "^3.3.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.5",
    "@types/events": "^3.0.3",
    "@wxt-dev/module-vue": "^1.0.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "prettier": "^3.9.10",
    "sass": "^1.105.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wxt": "^0.21.4"
  }
}
